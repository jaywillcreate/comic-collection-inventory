# Longbox Archive configuration (local dev — Node loads this via --env-file-if-exists)
PORT=4000

# --- Database -----------------------------------------------------------
# Local default: built-in SQLite at DB_PATH (":memory:" for ephemeral).
# Production (Vercel): connect Neon Postgres — POSTGRES_URL wins when set.
DB_PATH=data/longbox.db
# POSTGRES_URL=postgres://user:pass@host/db?sslmode=require

# --- Cover scans ---------------------------------------------------------
# Local default: files under UPLOAD_DIR, served at /uploads.
# Production (Vercel): connect a Blob store — BLOB_READ_WRITE_TOKEN wins when set.
UPLOAD_DIR=uploads
# BLOB_READ_WRITE_TOKEN=

# --- Cover lookup ----------------------------------------------------------
# Free key from https://comicvine.gamespot.com/api/ — enables automatic cover
# matching on accession and the scripts/backfill-covers.mjs bulk run.
COMICVINE_API_KEY=

# --- HTTP ----------------------------------------------------------------
# Comma-separated allowed origins for a split deployment, or * for any.
CORS_ORIGIN=*

# Set this in any shared/production deployment. When set, POST/PATCH/DELETE,
# uploads and seed-reset require the header:  x-api-key: <value>
# (Give the same value to the web build as VITE_ADMIN_KEY.)
ADMIN_API_KEY=
