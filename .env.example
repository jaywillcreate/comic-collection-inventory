# Longbox Archive API configuration
PORT=4000

# SQLite database file (created on first run; ":memory:" for ephemeral)
DB_PATH=data/longbox.db

# Directory for uploaded cover scans (served at /uploads)
UPLOAD_DIR=uploads

# Comma-separated allowed origins for the catalog/CMS frontend, or * for any
CORS_ORIGIN=*

# Set this in any shared/production deployment. When set, POST/PATCH/DELETE,
# uploads and seed-reset require the header:  x-api-key: <value>
ADMIN_API_KEY=
